modules = ["java-graalvm22.3"]

[nix]
channel = "stable-25_05"
packages = ["android-tools"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "CallSync Server"

[[workflows.workflow]]
name = "CallSync Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /tmp/callsync-server-git && go build -mod=vendor -o /tmp/callsync-server-bin . && PORT=5000 /tmp/callsync-server-bin"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
